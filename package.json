{
  "name": "ez-game-audio-conversion",
  "version": "1.6.0",
  "description": "Unattended batch conversion for game audio file types with loop tag support! Powered by ffmpeg.",
  "type": "module",
  "main": "dist/app.js",
  "bin": {
    "ez-game-audio-conversion": "dist/app.js"
  },
  "scripts": {
    "readme": "echo '\n📚 Available CLI Commands:\n\n🔧 Development:\n  npm run dev         - Run with ts-node\n  npm run dev:watch   - Run with nodemon and auto-restart\n  npm run dev:js      - Build then run JS version\n\n🏗️  Building:\n  npm run build:ts    - Compile TypeScript\n  npm run build:watch - Compile with watch mode\n  npm run package     - Build and create executable\n  npm run build       - Full build (TS + package)\n\n🧪 Testing:\n  npm run test        - Run Jest tests\n  npm run test:ci     - Run tests for CI\n  npm run test:coverage - Run with coverage report\n  npm run smoke       - Run smoke tests\n\n✨ Code Quality:\n  npm run lint        - Run ESLint\n  npm run format      - Format with Prettier\n  npm run clean       - Remove dist/release folders\n\n📖 Help:\n  npm run readme      - Show this help\n'",
    "dev": "npx ts-node ./src/app.ts",
    "dev:watch": "nodemon --exec \"npx ts-node ./src/app.ts\" --ext ts --ignore dist/ --ignore node_modules/",
    "dev:js": "npm run build:ts && node ./dist/app.js",
    "build:ts": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "package": "npm run build:ts && pkg .",
    "build": "npm run build:ts && npm run package",
    "clean": "rimraf dist/ release/",
    "test": "jest \"src/__tests__/\" --runInBand",
    "test:ci": "jest \"src/__tests__/\" --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand",
    "smoke": "npm run package && npm run smoke:postpackage",
    "smoke:postpackage": "node scripts/smokeTest.js",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "pkg": {
    "main": "dist/app.js",
    "assets": [
      "dist/converterWorker.js"
    ],
    "targets": [
      "node24-win-x64",
      "node24-linux-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "cfonts": "^3.2.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.5.0",
    "moment": "^2.30.1",
    "winston": "^3.14.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceFoon/Ez-Game-Audio-Conversion.git"
  },
  "keywords": [
    "Audio",
    "ffmpeg",
    "transcoding"
  ],
  "author": "SpaceFoon",
  "license": "CC-BY-NC-SA-4.0",
  "bugs": {
    "url": "https://github.com/SpaceFoon/Ez-Game-Audio-Conversion/issues"
  },
  "homepage": "https://github.com/SpaceFoon/Ez-Game-Audio-Conversion#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.5",
    "markdown-to-html-cli": "^5.0.3",
    "md-to-pdf": "^5.2.4",
    "nodemon": "^3.1.10",
    "pkg": "^5.8.1",
    "prettier": "^3.6.2",
    "resedit": "^2.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/test-utils/",
      "/src/__tests__/test-utils/",
      "/src/__tests__/utils\\.(js|ts)$",
      "/__tests__/run-tests.js",
      "/__tests__/format-loop-test.js",
      "/__tests__/test-utils/run-all-tests.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/build/",
      "<rootDir>/release/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/**/__tests__/**",
      "!src/**/test-utils/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 50,
        "lines": 55,
        "statements": 55
      }
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
