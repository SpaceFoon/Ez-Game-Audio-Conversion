{
  "name": "ez-game-audio-conversion",
  "version": "1.8.0",
  "description": "Unattended batch conversion for game audio file types with loop tag support! Powered by ffmpeg.",
  "type": "module",
  "main": "dist/app.js",
  "bin": {
    "ez-game-audio-conversion": "dist/app.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "readme": "echo '\n📚 Getting Started:\n   nvm install && nvm use && npm install\n\n🔧 Development:\n   npm run dev          Build & run\n   npm run build:watch  Auto-rebuild while coding\n\n🧪 Testing:\n   npm run test         Run all tests\n   npm run test:coverage With coverage report\n\n✨ Quality:\n   npm run fix          Lint & format code\n\n🏗️  Release (Local):\n   npm run package      Build SEA + ZIP/7z\n   npm run smoke        Test the packaged binary\n\n🚀 Release (CI/CD):\n   git tag v1.x.x && git push origin v1.x.x\n   → Builds Windows, Linux, macOS automatically\n   → Or: GitHub Actions → Release Build → Run workflow\n\n🧹 Cleanup:\n   npm run clean        Remove dist/ & release/\n'",
    "dev": "tsc -p tsconfig.json && node ./dist/app.js",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:sea": "npm run build && node scripts/build-sea.js",
    "package": "npm run build:sea && node scripts/post-sea.js",
    "clean": "rimraf dist/ release/",
    "install": "node scripts/install.js",
    "install:ffmpeg": "node scripts/install-ffmpeg.js",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js \"src/__tests__/\" --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js \"src/__tests__/\" --runInBand --testPathIgnorePatterns=/integration/ --testPathIgnorePatterns=/property/ --testPathIgnorePatterns=/fuzz/ --testPathIgnorePatterns=real_files.test.ts --testPathIgnorePatterns=workerProtocol.integration.test.ts",
    "test:integration": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand \"src/__tests__/integration/\" \"src/__tests__/real_files.test.ts\" \"src/__tests__/workerProtocol.integration.test.ts\"",
    "test:e2e": "npm run test:integration",
    "test:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js \"src/__tests__/property/\" --runInBand",
    "test:fuzz": "node --experimental-vm-modules node_modules/jest/bin/jest.js \"src/__tests__/fuzz/\" --runInBand",
    "test:mutation": "cross-env NODE_OPTIONS=--experimental-vm-modules stryker run stryker.conf.json",
    "test:mutation:pure": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8192\" stryker run stryker.conf.pure.json",
    "test:all": "npm test",
    "coverage:gaps": "node scripts/coverage-gaps.mjs",
    "test:pre-release": "npm run test:unit && npm run test:property && npm run test:integration && npm run test:smoke",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js \"src/__tests__/\" --runInBand --detectOpenHandles",
    "test:release": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand \"src/__tests__/integration/metadataPreservation.test.ts\" \"src/__tests__/app.test.ts\"",
    "test:coverage": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand \"src/__tests__/\"",
    "smoke": "npm run package && node src/__tests__/smokeTest.mjs",
    "test:smoke": "node src/__tests__/smokeTest.mjs",
    "fix": "eslint . --ext .ts,.js --fix && prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "cfonts": "^3.2.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "moment": "^2.30.1",
    "winston": "^3.14.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceFoon/Ez-Game-Audio-Conversion.git"
  },
  "keywords": [
    "Audio",
    "ffmpeg",
    "transcoding"
  ],
  "author": "SpaceFoon",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/SpaceFoon/Ez-Game-Audio-Conversion/issues"
  },
  "homepage": "https://github.com/SpaceFoon/Ez-Game-Audio-Conversion#readme",
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.2",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fast-check": "^4.8.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.1.5",
    "markdown-to-html-cli": "^5.0.3",
    "md-to-pdf": "^5.2.4",
    "nodemon": "^3.1.10",
    "pe-library": "^2.0.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.6.2",
    "resedit": "^3.0.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.stryker-tmp/",
      "/__tests__/test-utils/",
      "/src/__tests__/test-utils/",
      "/src/__tests__/utils\\.(js|ts)$",
      "/__tests__/run-tests.js",
      "/__tests__/format-loop-test.js",
      "/__tests__/test-utils/run-all-tests.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/build/",
      "<rootDir>/release/",
      "<rootDir>/.stryker-tmp/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "cjs",
      "jsx",
      "json",
      "node"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__tests__/**",
      "!src/types/**",
      "!src/ico/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "verbose": false,
    "forceExit": true,
    "testTimeout": 30000,
    "workerIdleMemoryLimit": "512MB"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
