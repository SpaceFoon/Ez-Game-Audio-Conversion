{
  "name": "ez-game-audio-conversion",
  "version": "1.6.0",
  "description": "Unattended batch conversion for game audio file types with loop tag support! Powered by ffmpeg.",
  "main": "dist/app.js",
  "bin": {
    "ez-game-audio-conversion": "dist/app.js"
  },
  "scripts": {
    "dev": "npx ts-node ./src/app.ts",
    "dev:js": "npm run build:ts && node ./dist/app.js",
    "build:ts": "tsc -p tsconfig.json",
    "package": "npm run build:ts && pkg .",
    "build:unix": ".\\build\\build.sh",
    "build:win": ".\\build\\build.bat",
    "build": "npm run build:ts && echo off && echo \"BASH SCRIPT NOT MADE YET\" && npm run build:win || npm run build:unix",
    "test": "jest \"src/__tests__/\" --runInBand",
    "test:ci": "jest \"src/__tests__/\" --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand",
    "smoke": "npm run package && npm run smoke:postpackage",
    "smoke:postpackage": "node scripts/smokeTest.js",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write ."
  },
  "pkg": {
    "main": "dist/app.js",
    "assets": [
      "dist/converterWorker.js"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "cfonts": "^3.2.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.5.0",
    "moment": "^2.30.1",
    "winston": "^3.14.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceFoon/Ez-Game-Audio-Conversion.git"
  },
  "keywords": [
    "Audio",
    "ffmpeg",
    "transcoding"
  ],
  "author": "SpaceFoon",
  "license": "CC-BY-NC-SA-4.0",
  "bugs": {
    "url": "https://github.com/SpaceFoon/Ez-Game-Audio-Conversion/issues"
  },
  "homepage": "https://github.com/SpaceFoon/Ez-Game-Audio-Conversion#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "markdown-to-html-cli": "^5.0.3",
    "md-to-pdf": "^5.2.4",
    "pkg": "^5.8.1",
    "prettier": "^3.6.2",
    "resedit": "^2.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/test-utils/",
      "/src/__tests__/test-utils/",
      "/src/__tests__/utils\\.(js|ts)$",
      "/__tests__/run-tests.js",
      "/__tests__/format-loop-test.js",
      "/__tests__/test-utils/run-all-tests.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/build/",
      "<rootDir>/release/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/**/__tests__/**",
      "!src/**/test-utils/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 50,
        "lines": 55,
        "statements": 55
      }
    }
  }
}
