{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "plugins": ["@stryker-mutator/jest-runner"],
  "reporters": ["html", "clear-text", "progress"],
  "concurrency": 1,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 80
  },
  "mutate": [
    "src/createConversionList.ts:28-65",
    "src/createConversionList.ts:120-142",
    "src/metadataService.ts:128-316",
    "src/metadataService.ts:372-576"
  ],
  "jest": {
    "enableFindRelatedTests": true,
    "projectType": "custom",
    "config": {
      "testEnvironment": "node",
      "extensionsToTreatAsEsm": [".ts"],
      "moduleNameMapper": {
        "^(\\.{1,2}/.*)\\.js$": "$1"
      },
      "transform": {
        "^.+\\.ts$": ["ts-jest", { "useESM": true }]
      },
      "testMatch": ["**/__tests__/**/*.test.ts"],
      "testPathIgnorePatterns": [
        "/node_modules/",
        "/__tests__/test-utils/",
        "/integration/",
        "real_files.test.ts",
        "seaBuild.test.ts",
        "createConversionList.stress.test.ts"
      ]
    }
  },
  "coverageAnalysis": "off",
  "timeoutMS": 30000,
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "Regex",
      "BlockStatement",
      "OptionalChaining"
    ]
  }
}
